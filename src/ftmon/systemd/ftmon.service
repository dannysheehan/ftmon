[Unit]
Description=FTMON local systems monitor
Documentation=https://github.com/dsheehan/ftmon
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ftmon daemon
# SIGHUP re-reads definitions, channels, and the check registry without
# dropping monitor state (PM-11).
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# FTMON is intentionally a per-user service. NoNewPrivileges reduces ambient
# authority without changing process identity. Do not add PrivateTmp here:
# systemd implements it for user units through an unprivileged user namespace,
# mapping other host users to the overflow uid and corrupting process.username.
NoNewPrivileges=yes

[Install]
WantedBy=default.target
